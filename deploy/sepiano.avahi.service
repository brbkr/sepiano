<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Installed as /etc/avahi/services/sepiano.service. Advertises the web UI
     and, for the future iOS app's Bonjour discovery, the API. -->
<service-group>
  <name replace-wildcards="yes">Piano on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>80</port>
    <txt-record>path=/</txt-record>
  </service>
  <service>
    <type>_sepiano._tcp</type>
    <port>80</port>
    <txt-record>api=/api/v1</txt-record>
  </service>
</service-group>
